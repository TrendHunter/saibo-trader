POLYMARKET_CHAIN_ID=137
POLYMARKET_HOST=https://clob.polymarket.com
POLYMARKET_FUNDER=0xYourPolygonWalletAddress
POLYMARKET_SIGNER=0xYourMetaMaskOrExportedWalletAddress
POLYMARKET_PRIVATE_KEY=0xYourWalletPrivateKey

# Shadow/compare: 0.99 ≈ disable cap; production live: 0.35
RISK_MAX_POSITION_FRACTION=0.99
RISK_DAILY_LOSS_LIMIT=0.20
RISK_TOTAL_DRAWDOWN_KILL=0.40
RISK_MAX_CONCURRENT_POSITIONS=2

FEE_RATE=0.018

# Spot reference for LIH/mm2 (settlement = Chainlink). Prefer Polymarket RTDS Chainlink.
CHAINLINK_FEED_ENABLED=true
# Legacy CEX feed — keep off when Chainlink is on (oracle gap vs settlement).
BINANCE_FEED_ENABLED=false

# 市场开关（5m/15m 窗口 + 币种；命名保留 DH_ENABLE_* 兼容 Web）
DH_ENABLE_5M=true
DH_ENABLE_15M=true
DH_ENABLE_5M_BTC=true
DH_ENABLE_5M_ETH=true
DH_ENABLE_5M_SOL=true
DH_ENABLE_15M_BTC=true
DH_ENABLE_15M_ETH=true

# REST+WS 订单簿感知（LIH 检测用）
BOOK_AWARE_DETECT=true

# Live only: validate LIH legs against REST book; default true = shadow only, no CLOB POST
LIVE_LIH_DRY_RUN=true
# Shadow dry-run bankroll (USDC); 0 = use real wallet balance. Disables wallet sync when set.
# PnL tracking start only — shadow mode keeps trading even if balance goes negative.
SHADOW_BANKROLL_USDC=500
# Per-window ledger for mm2 comparison (BTC 5m): logs/shadow_windows.jsonl
SHADOW_WINDOW_LOG=true
SHADOW_WINDOW_ASSET=btc
SHADOW_WINDOW_MINUTES=5

# Leg-in hedge (only strategy)
LIH_USE_MIRROR=false
# Leg1 mode:
#   cheap   = buy ask≤LEG1_MAX (legacy)
#   trend   = Binance-trend side up to TREND_MAX
#   trigger = shadow-style: either side ask≥TRIGGER_MIN (pick higher); matches 9h WS nosoft study
#   mm2 = late-window spot+favorite entry (also sets LIH_MM2_MODE)
LIH_LEG1_MODE=trigger
LIH_LEG1_TRIGGER_MIN=0.70
# Upper cap for trigger leg1 (0 = no cap). v0.12.1 band: 0.70–0.75 blocks 0.99 endgame entries.
LIH_LEG1_TRIGGER_MAX=0.75
# LIH decision quotes: rest = REST-only (align Python shadow); conservative = max(WS,REST)
LIH_QUOTE_MODE=rest
LIH_LEG1_TREND_MAX_PRICE=0.65
LIH_LEG1_MAX_PRICE=0.45
LIH_TARGET_COMBINED=0.97
LIH_OPEN_GAP=true
# mm2-style late entry: spot momentum + favorite side, slow heavy, delayed hedge
# LIH_MM2_MODE=true auto-applies morphology defaults (late entry band, gap~144); runs 24h — mm2 compare uses same-window overlap
LIH_MM2_MODE=false
# 0 = never use spot branch (always cheap side on flat); mm2_mode default 8
LIH_MM2_MIN_SPOT_BPS=8
# Only enter when secs_left <= N (mm2_mode default 180 → sec_in>=120 on 5m; aligns mm2 ~120–200s entries)
LIH_MM2_ENTRY_MAX_SECS_LEFT=180
LIH_MM2_ENTRY_MIN_SECS_LEFT=45
# mm2_mode default 0.08 — real mm2 often leg1 px 0.08–0.48; 0.52 blocked most mm2 windows
LIH_MM2_FAVORITE_MIN=0.08
LIH_MM2_HEAVY_DELAY_SEC=40
LIH_MM2_SCALE_CLIP=10
# Stop same-side scale when spot against heavy by >= this many bps (0=off). against_only.
# Off until research_windows>=100 and multi-day Δ same sign; was 5 during explore.
LIH_MM2_SCALE_AGAINST_STOP_BPS=0
# HF1-E′ shadow: latch no same-side scale when gap<=80 and secs_left<=100 (0=off)
# LIH_MM2_HF1E_LATCH_GAP=80
# LIH_MM2_HF1E_LATCH_SECS_LEFT=100
# v2k path sizing: scale beyond leg1; spot-favor/against boosts (1=off)
# LIH_MM2_HEAVY_MAX_SHARES=200
# LIH_MM2_SCALE_BOOST=3
# LIH_MM2_HEDGE_BOOST=3
# Early lane (secs_left in (ENTRY_MAX, EARLY_MAX]): strong-spot / tilt-fav only; 0=late-only
# LIH_MM2_EARLY_ENTRY_MAX_SECS_LEFT=180
# LIH_MM2_EARLY_TILT_MIN_SPREAD=0.35
# LIH_MM2_EARLY_TILT_MIN_FAV=0.65
# Early lane YES guard (B′ hole-fix): YES must be favorite AND yes_ask>=EARLY_TILT_MIN_FAV
# AND spread>=EARLY_TILT_MIN_SPREAD. Blocks cheap/underdog YES in early lane. Default OFF.
# LIH_MM2_EARLY_YES_GUARD=false
# Fav-early clock bypass (research): allow leg1 before EARLY_MAX when favorite book shaped.
# Default OFF. Prefer shadow (LIVE_LIH_DRY_RUN) first. Mode B = spread|Δtilt; Mode C = favAsk band + shape.
# LIH_MM2_FAV_EARLY_BYPASS=false
# LIH_MM2_FAV_EARLY_MODE=B
# LIH_MM2_FAV_EARLY_FAV_LO=0.52
# LIH_MM2_FAV_EARLY_FAV_HI=0.65
# LIH_MM2_FAV_EARLY_MIN_SPREAD=0.15
# LIH_MM2_FAV_EARLY_MIN_DTILT=0.10
# Secondary (off BJ main field): skip cheap lottery asks. Main = [START, END) Beijing hour of window open.
# LIH_MM2_MAIN_BJ_START=8
# LIH_MM2_MAIN_BJ_END=17
# LIH_MM2_OFFHOURS_MIN_ASK=0.28
# Daytime low_liquidity proxy: skip if min(yes,no) rest ask depth < N (0=off). Main-field only by default.
# LIH_MM2_MIN_SIDE_DEPTH=25
# LIH_MM2_MIN_SIDE_DEPTH_MAIN_ONLY=true
# v2i: cap notional when following strong spot (0=off)
# LIH_MM2_SPOT_LEG1_MAX_USDC=40
# LIH_MM2_SPOT_HEAVY_MAX_USDC=80
# mm2 session whitelist (UTC hour of window open, end exclusive). OFF by default (end=-1).
# Opt-in only if you want bot to mimic mm2 clock; overlap compare does NOT require this.
# LIH_MM2_SESSION_UTC_START=0
# LIH_MM2_SESSION_UTC_END=-1
# P4: session hours from m2/YYYY-MM-DD/windows.jsonl (scripts/mm2_session_refresh.py)
# Open 24h shadow (compare mm2 offline): set all three false below.
# LIH_MM2_SESSION_FROM_OBS=false
# LIH_MM2_OBS_SKIP_FROM_PACK=false
# LIH_MM2_SKIP_FLAT=false
# Alignment mode (tighter; needs fresh m2 pack + mm2_session_refresh):
# LIH_MM2_SESSION_FROM_OBS=true
# LIH_MM2_SESSION_FILE=data/mm2_session_active.json
# P4: skip leg1 when |spot_bps| below threshold (flat_book proxy; keep too_late entry)
# LIH_MM2_SKIP_FLAT=true
# LIH_MM2_FLAT_MAX_SPOT_BPS=0.5
# LIH_MM2_FLAT_MAX_ASK_SUM=0
# Mirror mm2 per-window skip from observation pack (except too_late):
# LIH_MM2_OBS_SKIP_FROM_PACK=true
# LIH_MM2_OBS_M2_ROOT=m2
# Replay m2 leg1 only (same window/side after mm2 sec_in); hedge = bot LIH.
# Disables session/flat/obs entry gates. Needs near-live m2 pack push.
# LIH_MM2_REPLAY_LEG1=true
# LIH_MM2_REPLAY_LAG_TOL_SEC=15
# P8 volatility gate (spot band + snap choppiness; on top of P7 flat/session):
# LIH_MM2_VOL_GATE=true
# LIH_MM2_VOL_MIN_SPOT_BPS=3.0
# LIH_MM2_VOL_MAX_SPOT_BPS=7.0
# LIH_MM2_VOL_MAX_SPOT_STD=2.5
# v2j adaptive side (after strong spot): mom∧fav≤0.60 or spread≥0.12∧fav≤0.58 → favorite; else cheap
# LIH_MM2_V2J_ADAPTIVE=true
# Tilt-formation entry (research A): wait |Δtilt| then adaptive_ext2 side
# LIH_MM2_TILT_ENTRY=true
# LIH_MM2_TILT_DELTA=0.25
# LIH_MM2_V2J_MOM_LOOKBACK_SEC=60
# LIH_MM2_V2J_MOM_FAV_MAX_ASK=0.60
# LIH_MM2_V2J_SPREAD_MIN=0.12
# LIH_MM2_V2J_SPREAD_FAV_MAX_ASK=0.58

LIH_HEAVY_CLIP_SHARES=50
LIH_HEAVY_MAX_PRICE=0.75
LIH_LEG1_SHARES=50
LIH_LEG1_CLIP_SHARES=5
# Interleave light-leg hedge clips (auto on when LIH_OPEN_GAP=true)
LIH_PARALLEL_CLIP_HEDGE=true
LIH_PARALLEL_HEDGE_MAX_COMBINED=1.05
# Open-gap: max |YES-NO| before forced gap-cap clips; 0 = off
LIH_MAX_GAP_SHARES=30
# Relaxed marginal when gap exceeds LIH_MAX_GAP_SHARES
LIH_GAP_HEDGE_MAX_COMBINED=1.15
# mm2-align v1 preset: GTC leg1 sim only (morphology defaults also apply when LIH_MM2_MODE=true)
LIH_MM2_ALIGN=false
# Hedge only when |YES-NO| >= trigger; clip toward target_min_gap not zero (mm2_mode default 90/144)
LIH_HEDGE_MIN_GAP_TRIGGER=0
LIH_HEDGE_TARGET_MIN_GAP=0
# leg1 execution for shadow dry-run: taker (FAK) or gtc (limit clip sim); live stays FAK
LIH_LEG1_ORDER_MODE=taker
# Optional hard ceiling; 0 = off
LIH_EARLY_HEDGE_MAX_COMBINED=0
LIH_LEG1_COOLDOWN_SECONDS=2
# No leg1 for first N seconds after 5m/15m window opens (0 = same as shadow study)
LIH_LEG1_START_DELAY_SEC=0
LIH_ALLOW_OVER_TARGET=false
LIH_FORCE_BALANCE_SECS=0
LIH_LEG1_TREND_ALIGN=false
LIH_TREND_LOOKBACK_SEC=60
# Endgame: shrink gap with 5/10-share steps (profit path still <= TARGET mid-window)
LIH_ENDGAME_SECS=100
LIH_ENDGAME_HOLD_ASK=0.90
LIH_ENDGAME_RESUME_HEDGE_ASK=0.89
# Gap-shrink ceiling in endgame when ladder disabled (ladder max overrides this)
LIH_ENDGAME_SOFT_CAP=1.05
LIH_MAX_ENTRY_MARGINAL=0
# v0.12.8: VWAP bilateral entry gate + min net edge (Roh execution layer)
LIH_VWAP_ENTRY_GATE=false
LIH_VWAP_ENTRY_CAP=0.98
LIH_VWAP_DEPTH_RATIO=0.90
LIH_MIN_EDGE_USDC=0
LIH_MIN_EDGE_PER_SHARE=0.05
# v0.12.9 Phase B: sell heavy leg at bid if still unhedged after T seconds
LIH_UNWIND_ENABLED=true
LIH_UNWIND_SECS=120
LIH_UNWIND_COOLDOWN=10
LIH_HEDGE_FEASIBLE_ENTRY=false
LIH_ENDGAME_OVERRIDE_SECS=0
LIH_ENDGAME_OVERRIDE_COOLDOWN=2
# true = never endgame-hold; always try to shrink gap
LIH_ENDGAME_MINIMIZE_GAP=true
# Last 90s: time-ramped marginal ladder 0.95→0.96→0.97 (never above END)
LIH_ENDGAME_LADDER_ENABLED=true
LIH_ENDGAME_LADDER_SECS=90
LIH_ENDGAME_LADDER_START=0.95
LIH_ENDGAME_LADDER_END=0.97
LIH_ENDGAME_LADDER_STEP=0.01
LIH_REBALANCE_MODE=flex
# Mid-window flex: hedge light leg in steps; no one-sided heavy-dilute after match.
# Paired scale/dilute (both legs) still applies when book sum <= target.
LIH_FLEX_DILUTE_RATIO=0.95
# 0 = budget-driven only (balance × RISK_MAX_POSITION_FRACTION); >0 optional share ceiling
LIH_MAX_REBALANCE_SHARES=0
LIH_MAX_MATCHED_SHARES=200
# Per market slot (asset+window) cumulative USDC cap for the whole round; 0 = balance × RISK_MAX_POSITION_FRACTION
LIH_MAX_USDC_PER_SLOT=0
# Stop new leg1 when fewer than N seconds remain (0 = no mid-window cutoff)
LIH_MIN_SECONDS_REMAINING=0
# No leg1 when fewer seconds remain — need room before endgame (5m: 180 = skip last 3min)
LIH_LEG1_MIN_SECONDS_REMAINING=180
# After restart/deploy: skip leg1 in windows that opened before bot boot
LIH_SKIP_PARTIAL_WINDOW_ON_START=true
LIH_COOLDOWN_SECONDS=0
# Split cooldowns (recommended): leg1 anti-spam, rebalance catch hedge prices
LIH_LEG1_COOLDOWN_SECONDS=20
LIH_REBALANCE_COOLDOWN_SECONDS=5
# Conservative rollout: false = BTC+ETH parallel (shadow study); true = one slot globally
LIH_ONE_SLOT_GLOBAL=false
# 0 = unlimited (continuous live). >0 caps legs per session — enforced only if DEBUG gates re-enabled in RiskManager.cpp
LIH_SESSION_MAX_LEGS=0
# true = auto-pause after each round (debug/test). false = run continuously; session resets on round close
LIH_PAUSE_AFTER_ROUND=false
# Minimum wallet USDC before new leg1 (20sh @0.70 ≈ $14)
# Block new leg1 when balance below this. Shadow dry-run ignores this (keeps running).
LIH_MIN_BALANCE_USDC=0
LIH_ENDGAME_STEP_SHARES_SMALL=5
LIH_ENDGAME_STEP_SHARES_LARGE=10
LIH_ENDGAME_GAP_LARGE=10
LIVE_MIRROR_PATH=logs/live_mirror.json

# 实盘余额同步间隔（秒）：trading-core + dashboard 钱包显示，默认 2
WALLET_SYNC_INTERVAL_SEC=2
# 链上 LIH 持仓对齐：兜底全量 reconcile 间隔（秒），默认 10；成交后会另触发 --positions-only
LIH_CHAIN_RECONCILE_SEC=10
# dashboard_bridge 维护线程是否跑链上 reconcile（实盘 LIVE_LIH_DRY_RUN=false 时）
LIVE_LIH_RECONCILE_ENABLED=true
# Gamma Up-Down 市场列表刷新间隔（秒）：新 5m/15m 窗口切换，默认 5（不宜低于 3）
GAMMA_MARKET_REFRESH_SEC=5

# --- Regime Gate (leg1 only; hedge unchanged) — see docs/regime-gate-spec.md ---
REGIME_GATE_ENABLED=false
# CRYPTOPANIC_AUTH_TOKEN=
# CRYPTOPANIC_API_PLAN=developer
REGIME_CP_POLL_SEC=90
REGIME_CP_FILTER=important
REGIME_CP_FRESH_MIN=15
REGIME_PRE_COOLDOWN_SEC=1800
REGIME_PRE_EXTEND_SEC=900
REGIME_PRE_MAX_SEC=7200
REGIME_STATE_FILE=data/regime/regime_pre.json
REGIME_MACRO_CALENDAR=data/regime/macro_calendar.json
REGIME_NEWS_KEYWORDS=data/regime/news_keywords.json
REGIME_THRESH_B=0.75
REGIME_THRESH_C=0.70
REGIME_B_JUMP_BPS=25
REGIME_B_WINDOW_BPS=40
REGIME_C_ASK_SUM_BAD=0.015
REGIME_C_MIN_DEPTH=50
REGIME_HEDGE_MARGIN=0.03

# Dashboard (Next.js): bot restart never auto-starts web (saves RAM on 1GB VPS).
# Set true only if deploy_vps_full.sh should bring up web when WEB_MODE is not set.
# Manual start on server: bash server_start_web.sh  (or scripts/start_web.sh)
START_WEB=false

# Bot HTTP API bind (127.0.0.1 = localhost only; WS still uses WS_HOST)
HTTP_BIND=127.0.0.1
# Optional: require X-Bot-Api-Token on POST /api/config|control|mirror (set same value in web.env)
# BOT_API_TOKEN=

# Live only: after DH expiry, redeem conditional tokens on Polygon (requires web3 + MATIC for gas)
AUTO_REDEEM=true
